APP_NAME=Hauzral Technologies API
APP_VERSION=2.0.0
DEBUG=false
ENVIRONMENT=production

PORT=8000
HOST=0.0.0.0

DATABASE_URL=postgres://hauzral:hauzral_password@localhost:5432/hauzral
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

SECRET_KEY=your-super-secret-jwt-key-change-in-production-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

OPENAI_API_KEY=your_openai_api_key_here

ADMIN_API_KEY=hauzral-admin-key-change-in-production

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=Hauzral Technologies <noreply@hauzral.com>

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=hauzral-uploads

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL=INFO
